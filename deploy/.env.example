# Copy to deploy/.env and adjust. docker compose reads it automatically.
# Defaults match the 12 GB laptop GPU used for the benchmark.
# Larger GPUs can raise GPU_MEMORY_UTILIZATION / MAX_MODEL_LEN / MAX_NUM_SEQS
# and switch MODEL to Qwen2.5-7B-Instruct.
MODEL=Qwen/Qwen2.5-1.5B-Instruct
SERVED_MODEL_NAME=qwen-1.5b
GPU_MEMORY_UTILIZATION=0.45
MAX_MODEL_LEN=2048
MAX_NUM_SEQS=32

# Use hf-mirror.com if huggingface.co is not reachable from your network.
HF_ENDPOINT=https://huggingface.co
HF_TOKEN=

VLLM_PORT=8000
GATEWAY_PORT=9000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Gateway backends. For the mock profile:
#   BACKENDS=mock-1=http://mock-vllm:18000
BACKENDS=vllm-1=http://vllm:8000

# Pin image tags if you need reproducible rebuilds.
VLLM_IMAGE=vllm/vllm-openai:latest
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana:11.3.0
